<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Member Application</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.5.0/semantic.min.css">
</head>
<body>
    <h1 class="ui header">
        <div class="content">Member Application Form</div>
    </h1>

    <div class="ui segment">
        <form class="ui form" action="/member/add" method="post">

            <div class="two fields">
                <div class="field">
                    <label>First Name</label>
                    <input type="text" name="memberFName" placeholder="First Name" required />
                </div>
                <div class="field">
                    <label>Last Name</label>
                    <input type="text" name="memberLName" placeholder="Last Name" required />
                </div>
            </div>

            <div class="field">
                <label>Member ID</label>
                <input type="number" name="memberID" placeholder="Member ID" required />
            </div>

            <div class="field">
                <label>Date of Birth</label>
                <input type="date" name="memberDOB" required />
            </div>

            <div class="field">
                <label>Join Date</label>
                <input type="date" name="memberJoinDate" required />
            </div>

            <button class="ui blue submit button" type="submit">
                <i class="check icon"></i> Submit Application
            </button>

        </form>
    </div>

    <a href="/" class="ui button">
         Back to Home
    </a>

</body>
</html>
