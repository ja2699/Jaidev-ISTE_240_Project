<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Available Books</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.5.0/semantic.min.css">
</head>
<body>
    <h1 class="ui header">
        <div class="content">Available Books</div>
    </h1>

    <table class="ui celled striped table">
        <thead>
        <tr>
            <th>Book ID</th>
            <th>Book Name</th>
            <th>Author</th>
        </tr>
        </thead>
        <tbody>
        {{#bookList}}
            <tr>
                <td>{{bookID}}</td>
                <td>{{bookName}}</td>
                <td>{{bookAuthor}}</td>
            </tr>
        {{/bookList}}
        </tbody>
    </table>

    <a href="/" class="ui button">
        Back to Home
    </a>

</body>
</html>